## ============================================================================
## deploy/homolog.env — ambiente do stack de HOMOLOGAÇÃO.  *** NÃO VERSIONAR ***
## (contém segredos; o .gitignore já cobre deploy/homolog.env)
##
## Como gerar na VPS (em /opt/discador-homolog):
##   cp /opt/discador/.env            deploy/homolog.env      # herda TODOS os segredos de produção
##   cat deploy/homolog.env.exemplo >> deploy/homolog.env     # anexa SÓ os overrides abaixo
##   # depois: editar DISCADOR_USERS/SESSION_SECRET com valores próprios (ver abaixo)
##
## Regra de ouro: os overrides ficam NO FIM do arquivo. O parser de env
## (dotenv/env_file do Docker) faz a ÚLTIMA ocorrência de cada chave vencer,
## então estas linhas sobrescrevem os valores de produção herdados do cp.
##
## >>> Voltar para prod = usar o stack de produção (deploy/discador.swarm.yaml).
##     Nenhum código muda entre os ambientes; só o env. <<<
## ============================================================================

## ---- SEGURANÇA 1/3: ClickUp de produção é SÓ-LEITURA em homolog ----
## fetchClickUp (clickup.ts) bloqueia POST/PUT/DELETE quando =false.
## Nenhum voto/desfecho/task de homolog altera uma task real de produção.
CLICKUP_ESCRITA_HABILITADA=false

## ---- SEGURANÇA 2/3: sem WhatsApp real (não envia nem recebe) ----
## URL vazia desliga o cliente Evolution (envio de áudio/texto);
## webhook token vazio faz o receptor de inbound responder 403 (desligado).
EVOLUTION_API_URL=
EVOLUTION_WEBHOOK_TOKEN=

## ---- ISOLAMENTO Supabase: tabelas hml_* (mesma instância de produção) ----
## Só as tabelas que o homolog ESCREVE ganham cópia hml_ (criadas por
## sql/homolog/00_homolog_tabelas.sql via LIKE ... INCLUDING ALL).
SUPABASE_TABLE_LEADS_ESPELHO=hml_discador_leads_espelho
SUPABASE_TABLE_VOTOS_LIGACAO=hml_votos_ligacao
SUPABASE_TABLE_MENSAGENS_WHATSAPP=hml_mensagens_whatsapp
SUPABASE_TABLE_WEBHOOK_EVENTOS=hml_webhook_eventos
SUPABASE_TABLE_USUARIOS=hml_discador_usuarios
## militantes / follow-ups: NÃO sobrescrever — homolog lê os de produção
## (referência somente-leitura; o app nunca escreve nessas tabelas).

## ---- Redis próprio do stack homolog (resolve na rede homolog_net) ----
REDIS_URL=redis://redis:6379

## ---- Login ISOLADO do homolog (não reusar o de produção) ----
## DISCADOR_USERS = "usuario:sha256hex,..."  — gere o hash com:
##   node --env-file=deploy/homolog.env scripts/senha.smoke.mjs   (ou o utilitário de senha do projeto)
## DISCADOR_SESSION_SECRET = openssl rand -hex 32
DISCADOR_USERS=admin:COLOQUE_O_SHA256_AQUI
DISCADOR_SESSION_SECRET=COLOQUE_UM_SEGREDO_NOVO_AQUI
