# LLM — Azure OpenAI (Tria, eastus2)
AZURE_OPENAI_RESOURCE_NAME=                                # ex: rober-mox7y720-eastus2
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_GPT41=gpt-4.1                      # modelo principal da Sofia
AZURE_OPENAI_DEPLOYMENT_GPT41_MINI=gpt-4.1-mini            # processors (PromptInjection, PII, scrubber)
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-large   # 3072 dim — atencao se pgvector ja tem 1536
AZURE_OPENAI_DEPLOYMENT_TRANSCRICAO=gpt-4o-transcribe-diarize  # substituto do Whisper

# OpenAI direto — DEPRECATED, mantido apenas para rollback rapido
# OPENAI_API_KEY=sk-proj-xxx

# GoHighLevel (canal WhatsApp via API oficial)
# PIT: Settings -> Integrations -> Private Integrations (escopos: conversations.write,
# conversations/message.write, contacts.readonly)
GHL_PIT_TOKEN=pit-xxxx
GHL_API_VERSION=2021-04-15
GHL_DEFAULT_TYPE=WhatsApp                                   # WhatsApp / SMS / Email / GMB / IG / FB

# Evolution API — DEPRECATED, mantido apenas pra rollback rapido caso precise voltar
# EVOLUTION_API_URL=https://evo.example.com
# EVOLUTION_API_KEY=xxx
# EVOLUTION_INSTANCE_NAME=roberth

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxx
SUPABASE_DB_URL=postgresql://postgres.xxx:senha@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Checkout — landing unica que apresenta Caminho da Rainha (R$ 1.997) + Bolha RR (R$ 2.997).
# A Sofia recomenda UM produto e o utm_term=caminho|bolha grava qual foi pra analytics.
CHECKOUT_URL_PRINCIPAL=https://roberthresende.com.br/checkout
# CHECKOUT_URL_ORDERBUMP=  # deprecated — URL unica agora pros 2 produtos

# Identificador da campanha — vai como utm_campaign no link
CAMPANHA_NOME=lancamento

# JID do grupo "SUPORTE CAMINHO DE RAINHA - IA" no WhatsApp.
# Recebe notificacao toda vez que a IA chama handoff humano.
# Pegue via GET /group/fetchAllGroups/<instance> na Evolution.
SUPORTE_GRUPO_JID=

# Dashboard de metricas (Basic Auth em /api/dashboard).
# Se ambos vazios, dashboard responde 503 (desabilitado por default — seguro).
# URL final em prod: https://<dominio>/api/dashboard
DASHBOARD_USER=admin
DASHBOARD_PASS=trocar-aqui