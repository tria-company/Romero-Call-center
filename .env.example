# ===== RomeroCall — variáveis de ambiente =====
# Copie para .env e preencha. Só estas variáveis são usadas pelo projeto.

# --- GoHighLevel (fonte de dados do dossiê / leads) ---
# PIT: Settings -> Integrations -> Private Integrations. Scopes: opportunities.readonly, contacts.readonly, contacts.write
GHL_PIT_TOKEN=
GHL_API_VERSION_V2=2021-07-28
GHL_LOCATION_ID=zEFpdSK1pMIC9d8aY4Lm
GHL_PIPELINE_ID=uVLzqVXjBjI7sACn3vKL

# --- Wavoip (SDK do navegador abre a ligação via WebRTC) ---
WAVOIP_DEVICE_TOKEN=
# Webhook Wavoip (transcrição das calls) — token fail-closed
WAVOIP_WEBHOOK_TOKEN=

# --- Login do discador (closers) ---
DISCADOR_USERS=
DISCADOR_SESSION_SECRET=

# --- Deepgram (transcrição de áudio das calls) ---
DEEPGRAM_API_KEY=

# --- ClickUp (store operacional — Lista 01 Leads / Lista 02 Ligações) ---
# Personal API Token: ClickUp -> Settings -> Apps -> API Token
CLICKUP_API_TOKEN=
# IDs já conhecidos (workspace Gabinete 509 / pasta Telemarketing 2.0):
CLICKUP_LIST_LEADS=1000320000002833
CLICKUP_LIST_LIGACOES=1000320000002834

# --- Operação (Fase 03) ---
# Status "em processamento" da Lista 02 LIGACOES (D-P3-07) — nome exato
# descoberto via scripts/descobrir-status-ligacoes.mjs. Vazio ate a
# descoberta rodar; sem ele, tocar Ligar nao remove a Ligacao da fila do
# operador (ver 03-01-SUMMARY.md pro nome escolhido).
OPER_STATUS_EM_PROCESSAMENTO=

# --- IA dos agentes (Contexto / Script / Análise) ---
# Provider atual: openai (temporário, enquanto sem Azure). Trocar para "azure" depois.
LLM_PROVIDER=openai
# OpenAI direto (uso atual):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Azure OpenAI (usar quando tiver as chaves; então LLM_PROVIDER=azure):
# AZURE_OPENAI_RESOURCE_NAME=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT=
