# ─────────────────────────────────────────────────────────────────────────────
#  Romero Albuquerque — variáveis de ambiente
#  Copie para `.env.local` e ajuste. Nada aqui vai para o cliente.
# ─────────────────────────────────────────────────────────────────────────────

# Usuários do login. Formato:  email:senha:Nome de Exibição
# Vários usuários separados por vírgula (ou por quebra de linha, com aspas).
# O e-mail não diferencia maiúsculas; a senha sim.
LOGIN_USERS="admin@admin.com:admin:Romero"

# Segredo do cookie de sessão (HMAC). Em produção use 32+ caracteres aleatórios.
# Sem isso, o app roda em dev com um segredo padrão e RECUSA subir em produção.
AUTH_SECRET="troque-este-segredo-por-32-caracteres-aleatorios"

# Validade da sessão, em horas.
AUTH_TTL_HORAS=12

# ─────────────────────────────────────────────────────────────────────────────
#  Integração com o discador RomeroCall (Wavoip)
#  Usadas por app/api/callcenter/token/route.ts (POST ${CALLCENTER_URL}/api/discador/login)
#  e por lib/contato.ts (monta a URL do discador com o token retornado).
#  NUNCA preencher segredo real neste arquivo — apenas em `.env.local` (gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# Base do discador RomeroCall (sem barra final). Default: producao no Vercel.
CALLCENTER_URL="https://romero-call-center.vercel.app"

# Login do discador (mesmas credenciais usadas para autenticar no POST /api/discador/login).
CALLCENTER_USUARIO="preencha-o-login-do-discador"

# Senha do discador. Peca ao operador responsavel pelo discador — nunca versionar valor real.
CALLCENTER_SENHA="preencha-a-senha-do-discador"
