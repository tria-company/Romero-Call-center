# ─────────────────────────────────────────────────────────────────────────────
#  Romero Albuquerque — variáveis de ambiente
#  Copie para `.env.local` e ajuste. Nada aqui vai para o cliente.
#
#  ARQUITETURA: app mobile gated single-tenant (só o acesso do Romero). Os dados
#  operacionais (fila, Lista 01 de leads, ficha, timeline, métricas) vêm do
#  BACKEND do discador via as pontes `app/api/mobile/*` — não há base local.
# ─────────────────────────────────────────────────────────────────────────────

# Login do app. Formato:  email:senha:Nome de Exibição
# Single-tenant: um ÚNICO registro, o acesso do Romero. É o portão principal.
# O e-mail não diferencia maiúsculas; a senha sim.
LOGIN_USERS="admin@admin.com:admin:Romero"

# Segredo do cookie de sessão (HMAC). Em produção use 24+ caracteres aleatórios.
# Sem isso, o app roda em dev com um segredo padrão e RECUSA subir em produção.
AUTH_SECRET="troque-este-segredo-por-32-caracteres-aleatorios"

# Validade da sessão, em horas.
AUTH_TTL_HORAS=12

# Endurecimento server-side da trava "só o Romero" (usado por lib/autorizacao.ts,
# `exigirRomero`, nas rotas app/api/mobile/* e callcenter/token). Lista curta de
# logins autorizados, minúsculas, separados por vírgula ou quebra de linha.
# VAZIA/ausente = qualquer sessão válida passa (o LOGIN_USERS único já é o portão);
# preenchida = só os logins da lista passam (senão 403).
ROMERO_LOGINS="admin@admin.com"

# ─────────────────────────────────────────────────────────────────────────────
#  Integração com o discador RomeroCall (Wavoip)
#  Conta de serviço usada por app/api/callcenter/token/route.ts
#  (POST ${CALLCENTER_URL}/api/discador/login) e por lib/contato.ts (monta a URL
#  do discador com o token retornado). A fila do Romero depende de essa conta
#  estar mapeada ao clickup_member_id dele em `discador_usuarios` (no backend).
#  NUNCA preencher segredo real aqui — apenas em `.env.local` (gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# Base do discador RomeroCall (sem barra final). Default: producao no Vercel.
CALLCENTER_URL="https://romero-call-center.vercel.app"

# Login do discador (mesmas credenciais usadas para autenticar no POST /api/discador/login).
CALLCENTER_USUARIO="preencha-o-login-do-discador"

# Senha do discador. Peca ao operador responsavel pelo discador — nunca versionar valor real.
CALLCENTER_SENHA="preencha-a-senha-do-discador"

# ─────────────────────────────────────────────────────────────────────────────
#  Env do BACKEND do discador (NÃO do mobile) — documentada aqui como lembrete.
#  As rotas de Lista 01 (Base e ficha do lead) só respondem se o backend do
#  discador tiver `DISCADOR_LEAD_BROWSE=1`; sem isso a UI mostra "não liberado"
#  (403). Configure no ambiente do backend, não neste app.
# ─────────────────────────────────────────────────────────────────────────────
# DISCADOR_LEAD_BROWSE=1
